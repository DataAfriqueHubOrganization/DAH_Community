# Copier en .env.prod (jamais commité) et remplir. Voir DEPLOY.md.

# ─── Domaine ─────────────────────────────────────────────────────
DOMAIN=dataafriquehub.org
LETSENCRYPT_EMAIL=contact@dataafriquehub.org

# ─── Django ──────────────────────────────────────────────────────
# Clé secrète longue et aléatoire : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALLOWED_HOSTS=dataafriquehub.org,www.dataafriquehub.org
CSRF_TRUSTED_ORIGINS=https://dataafriquehub.org
CORS_ALLOWED_ORIGINS=https://dataafriquehub.org
FRONTEND_URL=https://dataafriquehub.org

# ─── Base de données (conteneur « db », non exposé) ─────────────
DB_NAME=dah_db
DB_USER=dah
# Mot de passe long et aléatoire.
DB_PASSWORD=

# ─── Emails (API Brevo) ──────────────────────────────────────────
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@dataafriquehub.org
# Quota quotidien du plan Brevo (300 en gratuit) : bloque un email aux membres qui le dépasserait.
EMAIL_DAILY_QUOTA=300

# ─── JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── Sauvegardes (backup.sh) ─────────────────────────────────────
BACKUP_DIR=/var/backups/dah
